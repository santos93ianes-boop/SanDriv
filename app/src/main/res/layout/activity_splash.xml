<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#081522">

    <ImageView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:src="@drawable/sandrive_logo"
        android:contentDescription="SanDriv" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Seu caminho. Tudo à frente."
        android:textColor="#EAF7FF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Navegação • Clima • Postos • Alertas"
        android:textColor="#65C8FF"
        android:textSize="14sp" />

    <ProgressBar
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="34dp"
        android:indeterminateTint="#2EA8FF" />
</LinearLayout>
